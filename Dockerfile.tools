FROM node:22.23.4-bookworm-slim AS node
WORKDIR /app
COPY docker/tools/package.json docker/tools/package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force

FROM postgres:18-bookworm
WORKDIR /app
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /app/node_modules ./node_modules
COPY scripts/transfer-postgres.mjs scripts/bootstrap-prod.mjs scripts/backup-restore.mjs scripts/backup-manager.mjs ./scripts/
ENTRYPOINT ["node"]
