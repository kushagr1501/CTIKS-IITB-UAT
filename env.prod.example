# Use a long, URL-safe password (letters, numbers, underscore, hyphen).
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_URL_SAFE_PASSWORD
REDIS_NAMESPACE=ctiks
BETTER_AUTH_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS_LONG
BETTER_AUTH_URL=https://YOUR_SITE_HOSTNAME
ADMIN_EMAIL=admin@ctiks.local
# Temporarily add ADMIN_INITIAL_PASSWORD when provisioning the first admin.
# Temporarily add SOURCE_DATABASE_URL=postgresql://... (direct Neon URL) for a transfer.
# The target URL is generated inside compose.prod.yaml from POSTGRES_PASSWORD.
# Temporarily add RESTORE_DATABASE_NAME=ctiks_restore_check for a restore test.
