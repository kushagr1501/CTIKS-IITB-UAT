{
  "name": "ctiks-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:webpack": "prisma generate && next dev --webpack --hostname 127.0.0.1",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:local:up": "docker compose up -d postgres redis",
    "db:local:down": "docker compose stop postgres",
    "db:local:migrate": "node scripts/local-database.mjs migrate",
    "db:local:seed": "node scripts/local-database.mjs seed",
    "db:seed": "tsx scripts/seed.ts",
    "admin:provision": "node scripts/provision-admin.mjs",
    "db:restrict": "tsx scripts/restrict-database.ts",
    "db:verify": "tsx scripts/verify-database.ts",
    "redis:setup": "tsx scripts/setup-redis.ts",
    "redis:up": "docker compose up -d redis",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:integration": "tsx scripts/test-integration.ts",
    "test:uat": "node scripts/test-uat-integration.mjs",
    "test:faculty-schema": "tsx scripts/test-faculty-schema.ts",
    "test:browser": "tsx scripts/test-integration.ts"
  },
  "dependencies": {
    "@better-auth/redis-storage": "^1.3.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "argon2": "^0.41.1",
    "better-auth": "^1.3.0",
    "dotenv": "^18.0.8",
    "ioredis": "^5.4.1",
    "lenis": "^1.3.26",
    "next": "^16.4.2",
    "pg": "^8.23.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "^16.0.0",
    "postcss": "^8.4.47",
    "prettier": "^3.9.10",
    "prisma": "^7.10.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
