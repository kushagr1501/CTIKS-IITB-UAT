# UAT/production deployment template. Store real values only in the deployment
# environment or an ignored local file; never commit them.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DATABASE?sslmode=verify-full"
DIRECT_URL="postgresql://OWNER:PASSWORD@HOST.REGION.aws.neon.tech/DATABASE?sslmode=verify-full"
REDIS_URL="rediss://USER:PASSWORD@HOST:PORT"
REDIS_NAMESPACE="ctiks-uat"
BETTER_AUTH_SECRET="generate-a-unique-random-secret-with-at-least-32-characters"
BETTER_AUTH_URL="https://YOUR-UAT-OR-PRODUCTION-HOST"
ADMIN_EMAIL="admin@example.org"
